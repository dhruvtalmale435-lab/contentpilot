# ContentPilot AI — Backend Environment Configuration (.env.example)

ENVIRONMENT=development
PORT=8000

# AI Provider Configuration
# Leave blank to run in deterministic local mock mode (no paid API keys required for development/MVP)
OPENAI_API_KEY=

# Supabase Production Data & Auth (Optional for local development; app will use client-side seeded repository if omitted)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Owner Admin Security Key (Verified on privileged /admin routes)
ADMIN_SECRET_KEY=contentpilot-admin-dev-secret-key-2026
